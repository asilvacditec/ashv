<?xml version="1.0"?>
<!-- Compatibility entry point. The maintained build is pom.xml. -->
<project default="jar" name="ASHV">
  <condition property="mvn.command" value="mvn.cmd" else="mvn"><os family="windows"/></condition>
  <target name="clean"><exec executable="${mvn.command}" failonerror="true"><arg value="clean"/></exec></target>
  <target name="compile"><exec executable="${mvn.command}" failonerror="true"><arg value="compile"/></exec></target>
  <target name="jar"><exec executable="${mvn.command}" failonerror="true"><arg value="verify"/></exec></target>
  <target name="run" depends="jar"><java jar="target/ash-viewer.jar" fork="true" failonerror="true"/></target>
</project>
